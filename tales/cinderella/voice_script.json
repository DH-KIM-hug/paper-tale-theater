 "lines": [
  {
   "text": "옛날에 마음씨 고운 아가씨가 살았어요."
  },
  {
   "text": "넌 부엌 일을 해!",
   "segs": [
    [
     "step",
     "넌 부엌 일을 해!"
    ]
   ]
  },
  {
   "text": "재투성이래요~ 재투성이래요~",
   "segs": [
    [
     "sisa",
     "재투성이래요~"
    ],
    [
     "sisb",
     "재투성이래요~"
    ]
   ]
  },
  {
   "text": "그래서 아가씨는 신데렐라라고 불렸어요."
  },
  {
   "text": "어느 날, 궁전에서 무도회 편지가 왔어요."
  },
  {
   "text": "신데렐라, 내 머리 좀 예쁘게 해 줘!",
   "segs": [
    [
     "sisa",
     "신데렐라, 내 머리 좀 예쁘게 해 줘!"
    ]
   ]
  },
  {
   "text": "네, 예쁘게 해 드릴게요.",
   "segs": [
    [
     "cind",
     "네, 예쁘게 해 드릴게요."
    ]
   ]
  },
  {
   "text": "언니 머리를 톡 눌러 봐요."
  },
  {
   "text": "어머, 예쁘다!",
   "segs": [
    [
     "sisa",
     "어머, 예쁘다!"
    ]
   ]
  },
  {
   "text": "언니들은 신이 나서 무도회에 갔어요."
  },
  {
   "text": "혼자 남은 신데렐라는 훌쩍훌쩍 울었어요."
  },
  {
   "text": "나도 무도회에 가고 싶어요.",
   "segs": [
    [
     "cind",
     "나도 무도회에 가고 싶어요."
    ]
   ]
  },
  {
   "text": "그때 요정 대모가 나타났어요."
  },
  {
   "text": "울지 마렴. 너도 무도회에 가고 싶지? 내가 도와주마.",
   "segs": [
    [
     "fairy",
     "울지 마렴. 너도 무도회에 가고 싶지? 내가 도와주마."
    ]
   ]
  },
  {
   "text": "텃밭에서 제일 큰 호박을 가져오렴.",
   "segs": [
    [
     "fairy",
     "텃밭에서 제일 큰 호박을 가져오렴."
    ]
   ]
  },
  {
   "text": "호박을 톡 눌러 봐요."
  },
  {
   "text": "호박이 황금 마차가 되었어요!"
  },
  {
   "text": "쥐덫에 생쥐가 있구나. 몇 마리일까?",
   "segs": [
    [
     "fairy",
     "쥐덫에 생쥐가 있구나. 몇 마리일까?"
    ]
   ]
  },
  {
   "text": "쥐덫을 톡 눌러 봐요."
  },
  {
   "text": "생쥐가 여섯 마리! 하얀 말 여섯 마리가 되었어요."
  },
  {
   "text": "큰 쥐는 마부가, 도마뱀은 시종이 되었어요."
  },
  {
   "text": "이제 네 차례란다.",
   "segs": [
    [
     "fairy",
     "이제 네 차례란다."
    ]
   ]
  },
  {
   "text": "신데렐라는 은빛 드레스에 유리 구두를 신었어요."
  },
  {
   "text": "와, 정말 고맙습니다!",
   "segs": [
    [
     "cind",
     "와, 정말 고맙습니다!"
    ]
   ]
  },
  {
   "text": "꼭 기억하렴. 밤 열두 시가 되면 마법이 풀린단다.",
   "segs": [
    [
     "fairy",
     "꼭 기억하렴. 밤 열두 시가 되면 마법이 풀린단다."
    ]
   ]
  },
  {
   "text": "네, 꼭 기억할게요!",
   "segs": [
    [
     "cind",
     "네, 꼭 기억할게요!"
    ]
   ]
  },
  {
   "text": "궁전에 가니 모두 신데렐라를 바라보았어요."
  },
  {
   "text": "함께 춤춰요.",
   "segs": [
    [
     "prince",
     "함께 춤춰요."
    ]
   ]
  },
  {
   "text": "신데렐라는 언니들에게도 오렌지를 나눠 주었어요."
  },
  {
   "text": "어머, 고마워요!",
   "segs": [
    [
     "sisb",
     "어머, 고마워요!"
    ]
   ]
  },
  {
   "text": "언니들은 신데렐라를 알아보지 못했어요."
  },
  {
   "text": "시계를 보니 열두 시가 가까워요. 신데렐라는 약속대로 집에 돌아왔어요."
  },
  {
   "text": "다음 날 밤에도 무도회가 열렸어요."
  },
  {
   "text": "신데렐라는 춤추느라 시간 가는 줄 몰랐어요."
  },
  {
   "text": "긴 바늘과 짧은 바늘이 모두 12를 가리키면 열두 시예요. 열두 시 시계를 찾아봐요!"
  },
  {
   "text": "열두 시 시계를 찾아봐요!"
  },
  {
   "text": "그건 세 시예요."
  },
  {
   "text": "그건 여섯 시예요."
  },
  {
   "text": "바늘이 모두 위로 올라가면 열두 시예요."
  },
  {
   "text": "맞아요, 열두 시!"
  },
  {
   "text": "앗, 열두 시예요!",
   "segs": [
    [
     "cind",
     "앗, 열두 시예요!"
    ]
   ]
  },
  {
   "text": "신데렐라는 계단을 달려 내려가다 유리 구두 한 짝을 떨어뜨렸어요."
  },
  {
   "text": "이 구두가 꼭 맞는 사람을 찾을 거예요.",
   "segs": [
    [
     "prince",
     "이 구두가 꼭 맞는 사람을 찾을 거예요."
    ]
   ]
  },
  {
   "text": "왕자님이 유리 구두를 들고 집집마다 찾아다녔어요."
  },
  {
   "text": "내 발이 들어갈 거야!",
   "segs": [
    [
     "sisa",
     "내 발이 들어갈 거야!"
    ]
   ]
  },
  {
   "text": "내 발도 들어갈 거야!",
   "segs": [
    [
     "sisb",
     "내 발도 들어갈 거야!"
    ]
   ]
  },
  {
   "text": "언니들의 발은 너무 커서 들어가지 않았어요."
  },
  {
   "text": "저도 신어 봐도 될까요?",
   "segs": [
    [
     "cind",
     "저도 신어 봐도 될까요?"
    ]
   ]
  },
  {
   "text": "구두와 크기가 같은 발을 찾아봐요!"
  },
  {
   "text": "그 발은 구두보다 커요."
  },
  {
   "text": "맞아요, 작은 발!"
  },
  {
   "text": "구두가 꼭 맞았어요!"
  },
  {
   "text": "신데렐라는 주머니에서 다른 한 짝을 꺼냈어요."
  },
  {
   "text": "요정 대모가 다시 고운 옷을 입혀 주었어요."
  },
  {
   "text": "신데렐라, 그동안 미안해. 정말 미안해.",
   "segs": [
    [
     "sisa",
     "신데렐라, 그동안 미안해."
    ],
    [
     "sisb",
     "정말 미안해."
    ]
   ]
  },
  {
   "text": "괜찮아요. 우리 함께 행복해요.",
   "segs": [
    [
     "cind",
     "괜찮아요. 우리 함께 행복해요."
    ]
   ]
  },
  {
   "text": "신데렐라에게 톡 인사해요!"
  },
  {
   "text": "모두 함께 웃었어요."
  },
  {
   "text": "착한 마음은 나를 괴롭힌 사람도 용서할 수 있어요."
  }
